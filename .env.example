# Copy to .env and fill in. Never commit .env.
APP_NAME=Sentinel

# Google AI Studio key from ONE dedicated project for this app (free tier, no billing).
# Don't create extra projects to get more quota; Google's API terms forbid circumventing limits.
GOOGLE_API_KEY=
# HuggingFace read token (only if you got access to the gated Llama Prompt Guard 2; optional)
HF_TOKEN=
# Admin token for review/feedback/pattern/red-team endpoints: generate with `openssl rand -hex 24`
ADMIN_TOKEN=

BIND_HOST=127.0.0.1
DEV_MODE=true                 # enables chaos toggles; set false for the recorded demo

# Models by role; each model has its own free-tier quota inside the one project (verify IDs at startup)
JUDGE_MODEL=gemini-3.8-flash
JUDGE_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
ALIGNMENT_MODEL=gemini-3.7-flash
ALIGNMENT_FALLBACK_MODELS=gemini-3.5-flash
BLUETEAM_MODEL=gemini-3.5-flash
# Red team + test victim run on a LOCAL model via Ollama (free, unlimited, offline); Gemini is the fallback.
# Use whatever `ollama list` shows; gemma4:e2b is the example ADK's own source uses.
REDTEAM_MODEL=ollama_chat/gemma4:e2b
REDTEAM_FALLBACK_MODEL=gemini-3.5-flash-lite
VICTIM_MODEL=ollama_chat/gemma4:e2b
VICTIM_FALLBACK_MODEL=gemini-3.5-flash-lite
OLLAMA_API_BASE=http://127.0.0.1:11434
OCR_FALLBACK_MODEL=gemini-3.5-flash-lite

# Per-model limits: set to ~80% of what YOUR AI Studio dashboard (aistudio.google.com/rate-limit) shows.
# Placeholders below are conservative guesses; replace them.
RPM_LIMITS=gemini-3.8-flash=8,gemini-3.7-flash=8,gemini-3.6-flash=8,gemini-3.5-flash=8,gemini-3.5-flash-lite=12
DAILY_BUDGETS=gemini-3.8-flash=500,gemini-3.7-flash=300,gemini-3.6-flash=300,gemini-3.5-flash=300,gemini-3.5-flash-lite=600

# Classifiers: c1 = ProtectAI DeBERTa v2 (always). On a 16 GB Mac add c2_86m once Prompt Guard 2 access is granted.
CLASSIFIERS=c1,c2_86m
# cpu | mps (Apple GPU) | auto (benchmark once at startup, pick the faster per workload)
CLASSIFIER_DEVICE=auto
COVERED_SCRIPTS=auto          # derived from loaded classifiers (Devanagari only with c2_86m)

DEV_CACHE=true
VERDICT_CACHE=true

# Policy
UNTRUSTED_ALWAYS_REVIEW=true
AUDIT_SAMPLE_RATE=0.03
FAIL_MODE_UNTRUSTED=closed
REWRITE_ENABLED=false
LOG_RAW_CONTENT=false

# Egress guard
SENSITIVE_TOOLS=send_email,transfer_funds,delete_file,execute_code
EGRESS_ALLOWLIST=yourcompany.example
